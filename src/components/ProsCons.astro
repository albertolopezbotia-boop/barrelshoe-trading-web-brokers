---
interface Props {
  pros: string[];
  cons: string[];
}
const { pros, cons } = Astro.props;
---
<div class="pros-cons">
  <div class="col pros">
    <h3>Ventajas</h3>
    <ul>
      {pros.map((item) => <li>{item}</li>)}
    </ul>
  </div>
  <div class="col cons">
    <h3>Desventajas</h3>
    <ul>
      {cons.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</div>
<style>
  .pros-cons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }
  h3 {
    font-size: var(--font-size-lg);
    margin: 0 0 var(--space-3);
  }
  ul {
    margin: 0;
    padding-left: var(--space-6);
    display: grid;
    gap: var(--space-2);
  }
  .pros li::marker { content: "+ "; color: var(--color-accent); }
  .cons li::marker { content: "\2212 "; color: var(--color-warning-border); }
  @media (max-width: 640px) {
    .pros-cons { grid-template-columns: 1fr; }
  }
</style>
