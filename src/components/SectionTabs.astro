---
interface Props {
  items: Array<{ id: string; label: string }>;
}
const { items } = Astro.props;
---
<nav class="section-tabs" aria-label="Secciones de la ficha">
  <div class="section-tabs__inner">
    {items.map((it, i) => (
      <a href={`#${it.id}`} class:list={{ 'is-active': i === 0 }} data-tab={it.id}>
        {it.label}
      </a>
    ))}
  </div>
</nav>
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.section-tabs a[data-tab]')];
  const targets = links
    .map((a) => document.getElementById(a.dataset.tab!))
    .filter((el): el is HTMLElement => el !== null);
  if (targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            links.forEach((a) => a.classList.toggle('is-active', a.dataset.tab === e.target.id));
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
<style>
  .section-tabs {
    position: sticky;
    top: 56px;
    z-index: 4;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-8);
  }
  .section-tabs__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .section-tabs a {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .section-tabs a:hover { color: var(--color-primary); text-decoration: none; }
  .section-tabs a.is-active { background: var(--color-primary); color: var(--color-text-inverse); }
  @media (max-width: 639px) {
    .section-tabs { top: 92px; }
  }
</style>
