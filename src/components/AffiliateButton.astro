---
interface Props {
  href: string;
  broker: string;
  label?: string;
  ariaLabel?: string;
}
const { href, broker, label, ariaLabel } = Astro.props;
---
<a
  class="aff-btn"
  href={href}
  target="_blank"
  rel="sponsored nofollow noopener"
  aria-label={ariaLabel}
>
  <span>{label ?? `Abrir cuenta en ${broker}`}</span>
  <span class="aff-btn__arrow" aria-hidden="true">›</span>
</a>
<style>
  .aff-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background-image: var(--grad-brand);
    color: #0b0620;
    font-weight: 700;
    font-size: var(--font-size-sm);
    line-height: 1.2;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-pill);
    text-align: center;
    box-shadow: 0 6px 18px rgba(255, 107, 107, 0.28);
    transition: filter 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .aff-btn:hover {
    filter: brightness(1.06);
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(94, 199, 255, 0.3);
  }
  .aff-btn__arrow { font-weight: 800; }
</style>
