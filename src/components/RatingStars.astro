---
interface Props {
  value: number;
  showNumber?: boolean;
}
const { value, showNumber = false } = Astro.props;
const pct = Math.max(0, Math.min(100, (value / 5) * 100));
const formatted = new Intl.NumberFormat('es-ES', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
}).format(value);
---
<span class="rating" role="img" aria-label={`${formatted} sobre 5`}>
  {showNumber && <span class="number">{formatted}</span>}
  <span class="stars" aria-hidden="true">
    <span class="stars-bg">★★★★★</span>
    <span class="stars-fill" style={`width: ${pct}%`}>★★★★★</span>
  </span>
</span>
<style>
  .rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .stars {
    position: relative;
    display: inline-block;
    font-size: var(--font-size-base);
    line-height: 1;
    letter-spacing: 0.08em;
  }
  .stars-bg { color: var(--color-border-strong); }
  .stars-fill {
    position: absolute;
    inset: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--color-rating);
  }
  .number {
    font-weight: 800;
    font-size: var(--font-size-sm);
    color: var(--color-ink);
    background: var(--color-rating-bg);
    border: 1px solid var(--color-rating-border);
    border-radius: var(--radius-md);
    padding: 2px 8px;
  }
</style>
