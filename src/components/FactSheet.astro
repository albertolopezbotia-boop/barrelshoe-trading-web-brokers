---
import type { BrokerData } from '../lib/broker-schema';
import { money, pips, yesNo } from '../lib/format';
interface Props {
  broker: BrokerData;
}
const { broker } = Astro.props;
const facts: Array<{ label: string; value: string }> = [
  { label: 'Depósito mínimo', value: money(broker.minDeposit) },
  { label: 'Spread EUR/USD desde', value: pips(broker.spreadEurUsdFrom) },
  { label: 'Plataformas', value: broker.platforms.join(', ') },
  { label: 'Reguladores', value: broker.regulators.map((r) => r.authority).join(', ') },
  { label: 'Apalancamiento máx.', value: broker.leverageMax },
  { label: 'Cuenta demo', value: yesNo(broker.demoAccount) },
];
---
<dl class="fact-sheet">
  {facts.map((fact) => (
    <div class="row">
      <dt>{fact.label}</dt>
      <dd>{fact.value}</dd>
    </div>
  ))}
</dl>
<style>
  .fact-sheet {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
  dt { color: var(--color-text-muted); }
  dd { margin: 0; font-weight: 700; text-align: right; }
</style>
