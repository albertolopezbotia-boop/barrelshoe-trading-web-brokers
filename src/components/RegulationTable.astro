---
import type { BrokerData } from '../lib/broker-schema';
interface Props {
  regulators: BrokerData['regulators'];
}
const { regulators } = Astro.props;
---
<table class="regulation-table">
  <thead>
    <tr>
      <th scope="col">Autoridad</th>
      <th scope="col">País</th>
      <th scope="col">Nº de licencia</th>
      <th scope="col">Estado</th>
    </tr>
  </thead>
  <tbody>
    {regulators.map((r) => (
      <tr>
        <td>{r.authority}</td>
        <td>{r.country}</td>
        <td>{r.licenseNumber}</td>
        <td>{r.status}</td>
      </tr>
    ))}
  </tbody>
</table>
<style>
  .regulation-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }
  th, td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  th { color: var(--color-text-muted); }
  td:last-child { text-transform: capitalize; }
</style>
