---
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';

interface Props {
  onDark?: boolean;
}
const { onDark = false } = Astro.props;

const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const current = withSlash(Astro.url.pathname);
const isCurrent = (href: string) => withSlash(href) === current;
---
<div class="promo-bar">
  <p><strong>NUEVO</strong> Comparativa de brokers actualizada para 2026</p>
  <a class="promo-bar__cta" href="/#comparativa">Ver comparativa</a>
</div>
<header class:list={['site-header', { 'on-dark': onDark }]} data-on-dark={onDark ? '' : undefined}>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — inicio`}>
      <img class="brand__logo" src="/brand/barrelshoe-logo.png" alt={SITE.name} width="525" height="114" />
    </a>
    <nav class="site-nav" aria-label="Navegación principal">
      <ul>
        <li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Comparativa</a></li>
        {CATEGORIES.map((c) => (
          <li>
            <a
              href={`/mejores-brokers/${c.slug}/`}
              aria-current={isCurrent(`/mejores-brokers/${c.slug}/`) ? 'page' : undefined}
            >
              {c.shortTitle}
            </a>
          </li>
        ))}
        <li><a href="/metodologia/" aria-current={isCurrent('/metodologia/') ? 'page' : undefined}>Metodología</a></li>
      </ul>
    </nav>
    <a class="header-cta" href="/#comparativa">Ver comparativa</a>
  </div>
</header>
{onDark && (
  <script>
    const header = document.querySelector('.site-header.on-dark');
    if (header) {
      const onScroll = () => header.classList.toggle('is-solid', window.scrollY > 80);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  </script>
)}
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-shell-border);
    background: color-mix(in srgb, var(--color-shell) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .promo-bar {
    background: var(--color-primary-dark);
    color: var(--color-on-shell);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-xs);
    text-align: center;
  }
  .promo-bar p { margin: 0; }
  .promo-bar strong {
    color: var(--color-coral);
    font-weight: 800;
    margin-right: var(--space-1);
  }
  .promo-bar__cta {
    display: inline-flex;
    align-items: center;
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-ink);
    background: var(--color-on-shell);
    padding: 3px var(--space-3);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .promo-bar__cta:hover { text-decoration: none; filter: brightness(0.95); }

  .header-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }
  .brand {
    display: inline-flex;
    align-items: center;
  }
  .brand:hover { text-decoration: none; }
  .brand__logo {
    height: 1.9rem;
    width: auto;
  }
  .site-nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
  }
  .site-nav a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-on-shell-dim);
    font-size: var(--font-size-sm);
    font-weight: 600;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:hover { color: var(--color-on-shell); text-decoration: none; }
  .site-nav a[aria-current="page"] {
    color: var(--color-on-shell);
    border-bottom-color: var(--color-coral);
  }

  .header-cta {
    display: none;
  }

  /* transparent over the dark hero, until scrolled */
  .site-header.on-dark:not(.is-solid) {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
  }
  .site-header.on-dark:not(.is-solid) .site-nav a { color: var(--color-on-hero-dim); }
  .site-header.on-dark:not(.is-solid) .site-nav a:hover,
  .site-header.on-dark:not(.is-solid) .site-nav a[aria-current="page"] { color: var(--color-on-hero); border-bottom-color: var(--color-on-hero); }

  @media (min-width: 640px) {
    .header-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
      padding-block: var(--space-4);
    }
    .site-nav { flex: 1; display: flex; justify-content: center; }
  }
  @media (min-width: 860px) {
    .header-cta {
      display: inline-flex;
      align-items: center;
      flex: 0 0 auto;
      font-size: var(--font-size-sm);
      font-weight: 700;
      color: var(--color-on-shell);
      border: 1px solid rgba(255, 255, 255, 0.35);
      padding: var(--space-2) var(--space-5);
      border-radius: var(--radius-pill);
      white-space: nowrap;
    }
    .header-cta:hover { border-color: var(--color-on-shell); text-decoration: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
</style>
