---
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';

const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const current = withSlash(Astro.url.pathname);
const isCurrent = (href: string) => withSlash(href) === current;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">B</span>
      <span>{SITE.name}</span>
    </a>
    <nav class="site-nav" aria-label="Navegación principal">
      <ul>
        <li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Comparativa</a></li>
        {CATEGORIES.map((c) => (
          <li>
            <a
              href={`/mejores-brokers/${c.slug}/`}
              aria-current={isCurrent(`/mejores-brokers/${c.slug}/`) ? 'page' : undefined}
            >
              {c.shortTitle}
            </a>
          </li>
        ))}
        <li><a href="/metodologia/" aria-current={isCurrent('/metodologia/') ? 'page' : undefined}>Metodología</a></li>
      </ul>
    </nav>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: rgba(250, 249, 247, 0.85);
    backdrop-filter: saturate(1.4) blur(8px);
  }
  .header-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 800;
    letter-spacing: var(--letter-tight);
    font-size: var(--font-size-lg);
    color: var(--color-ink);
  }
  .brand:hover { text-decoration: none; }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-size: var(--font-size-sm);
    font-weight: 800;
  }
  .site-nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
  }
  .site-nav a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:hover { color: var(--color-primary); text-decoration: none; }
  .site-nav a[aria-current="page"] {
    color: var(--color-ink);
    border-bottom-color: var(--color-primary);
  }
  @media (min-width: 640px) {
    .header-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-block: var(--space-4);
    }
  }
</style>
