---
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';

interface Props {
  onDark?: boolean;
}
const { onDark = false } = Astro.props;

const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const current = withSlash(Astro.url.pathname);
const isCurrent = (href: string) => withSlash(href) === current;
---
<header class:list={['site-header', { 'on-dark': onDark }]} data-on-dark={onDark ? '' : undefined}>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — inicio`}>
      <img class="brand__logo" src="/brand/barrelshoe-logo.png" alt={SITE.name} width="525" height="114" />
    </a>
    <nav class="site-nav" aria-label="Navegación principal">
      <ul>
        <li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Comparativa</a></li>
        {CATEGORIES.map((c) => (
          <li>
            <a
              href={`/mejores-brokers/${c.slug}/`}
              aria-current={isCurrent(`/mejores-brokers/${c.slug}/`) ? 'page' : undefined}
            >
              {c.shortTitle}
            </a>
          </li>
        ))}
        <li><a href="/metodologia/" aria-current={isCurrent('/metodologia/') ? 'page' : undefined}>Metodología</a></li>
      </ul>
    </nav>
  </div>
</header>
{onDark && (
  <script>
    const header = document.querySelector('.site-header.on-dark');
    if (header) {
      const onScroll = () => header.classList.toggle('is-solid', window.scrollY > 80);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  </script>
)}
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: rgba(250, 249, 247, 0.85);
    backdrop-filter: saturate(1.4) blur(8px);
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .header-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }
  .brand {
    display: inline-flex;
    align-items: center;
  }
  .brand:hover { text-decoration: none; }
  .brand__logo {
    height: 1.9rem;
    width: auto;
  }
  .site-nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
  }
  .site-nav a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:hover { color: var(--color-primary); text-decoration: none; }
  .site-nav a[aria-current="page"] {
    color: var(--color-ink);
    border-bottom-color: var(--color-primary);
  }

  /* transparent over the dark hero, until scrolled */
  .site-header.on-dark:not(.is-solid) {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
  }
  .site-header.on-dark:not(.is-solid) .site-nav a { color: var(--color-on-hero-dim); }
  .site-header.on-dark:not(.is-solid) .site-nav a:hover,
  .site-header.on-dark:not(.is-solid) .site-nav a[aria-current="page"] { color: var(--color-on-hero); border-bottom-color: var(--color-on-hero); }

  @media (min-width: 640px) {
    .header-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-block: var(--space-4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
</style>
