---
import { SITE } from '../data/site';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <p class="brand">{SITE.name}</p>
        <p class="disclosure">
          Contenido con enlaces de afiliación: podemos cobrar una comisión de los brokers, sin coste para ti y sin afectar a nuestras valoraciones.
        </p>
      </div>
      <nav aria-label="Enlaces legales">
        <ul>
          <li><a href="/aviso-legal/">Aviso legal</a></li>
          <li><a href="/privacidad/">Privacidad</a></li>
          <li><a href="/sobre-nosotros/">Sobre nosotros</a></li>
          <li><a href="/metodologia/">Metodología</a></li>
        </ul>
      </nav>
    </div>
    <small class="risk">{SITE.riskWarning}</small>
    <p class="copy">© {new Date().getFullYear()} {SITE.name}</p>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-16);
    padding-block: var(--space-12);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
  .footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-8);
  }
  .brand {
    font-weight: 800;
    letter-spacing: var(--letter-tight);
    color: var(--color-ink);
    font-size: var(--font-size-lg);
  }
  .disclosure { margin-top: var(--space-2); max-width: var(--container-narrow); }
  .site-footer nav ul {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-footer nav a { font-weight: 600; }
  .risk {
    display: block;
    font-size: var(--font-size-xs);
    line-height: var(--line-base);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .copy { margin-top: var(--space-4); font-size: var(--font-size-xs); }
</style>
