---
import type { BrokerEntry } from '../lib/brokers';
import { money, pips } from '../lib/format';
import RatingStars from './RatingStars.astro';
import AffiliateButton from './AffiliateButton.astro';

interface Props {
  entry: BrokerEntry;
  position?: number;
}

const { entry, position } = Astro.props;
const { slug, data } = entry;
const reviewHref = `/brokers/${slug}/`;

const highlights = [
  { label: 'Depósito mínimo', value: money(data.minDeposit) },
  { label: 'Spread EUR/USD desde', value: pips(data.spreadEurUsdFrom) },
  { label: 'Plataformas', value: data.platforms.join(', ') },
];
const topPros = data.pros.slice(0, 2);
---

<article class="broker-card">
  {position && <span class="broker-card__badge" aria-label={`Puesto ${position}`}>#{position}</span>}
  <div class="broker-card__head">
    <img
      class="broker-card__logo"
      src={data.logo}
      alt={`Logo de ${data.name}`}
      width="120"
      height="40"
      loading="lazy"
    />
    <h3 class="broker-card__name">
      <a href={reviewHref}>{data.name}</a>
    </h3>
    <RatingStars value={data.rating} showNumber />
  </div>

  <dl class="broker-card__highlights">
    {
      highlights.map((h) => (
        <div class="broker-card__highlight">
          <dt>{h.label}</dt>
          <dd>{h.value}</dd>
        </div>
      ))
    }
  </dl>

  <ul class="broker-card__pros">
    {topPros.map((pro) => <li>{pro}</li>)}
  </ul>

  <div class="broker-card__actions">
    <AffiliateButton href={data.affiliateUrl} broker={data.name} />
    <a class="broker-card__review" href={reviewHref}>Leer análisis</a>
  </div>
</article>

<style>
  .broker-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  .broker-card__badge {
    position: absolute;
    top: calc(-1 * var(--space-3));
    left: var(--space-6);
    padding: var(--space-1) var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: #fff;
    background: var(--color-primary);
    border-radius: var(--radius-sm);
  }
  .broker-card__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .broker-card__logo {
    width: 120px;
    height: 40px;
    object-fit: contain;
    object-position: left center;
  }
  .broker-card__name {
    margin: 0;
    font-size: var(--font-size-lg);
  }
  .broker-card__highlights {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }
  .broker-card__highlight {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: var(--font-size-sm);
  }
  .broker-card__highlight dt {
    color: var(--color-text-muted);
  }
  .broker-card__highlight dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }
  .broker-card__pros {
    margin: 0;
    padding-left: var(--space-6);
    display: grid;
    gap: var(--space-1);
    font-size: var(--font-size-sm);
  }
  .broker-card__pros li::marker {
    content: "+ ";
    color: var(--color-accent);
  }
  .broker-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: auto;
  }
  .broker-card__review {
    font-size: var(--font-size-sm);
    font-weight: 700;
  }
</style>
