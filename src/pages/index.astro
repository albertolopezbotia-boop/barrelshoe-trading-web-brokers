---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import CategoryRanking from '../components/CategoryRanking.astro';
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';
import { sortByRank, sortByRating, type BrokerEntry } from '../lib/brokers';
import { organizationLd, websiteLd, itemListLd } from '../lib/jsonld';

const raw = await getCollection('brokers');
const entries: BrokerEntry[] = raw.map((e) => ({ slug: e.slug, data: e.data }));
const byRank = sortByRank(entries);
const top3 = sortByRating(entries).slice(0, 3);
const hasBrokers = entries.length > 0;

const monogram = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0] ?? '')
    .join('')
    .toUpperCase();

const catCardLabel: Record<string, string> = {
  mt4: 'Los mejores brokers con MT4',
  mt5: 'Los mejores brokers con MT5',
  ctrader: 'Los mejores brokers con cTrader',
  'copy-trading': 'Los mejores para copy trading',
  oro: 'Los mejores brokers para oro',
};

type HeroCard = { href: string; label: string; mono?: string };
const heroCards: HeroCard[] = [
  ...CATEGORIES.map((c) => ({
    href: `/mejores-brokers/${c.slug}/`,
    label: catCardLabel[c.slug] ?? `Los mejores brokers · ${c.shortTitle}`,
  })),
  { href: '#comparativa', label: 'Comparativa de los 10 brokers' },
  ...top3.slice(0, 2).map((e) => ({
    href: `/brokers/${e.slug}/`,
    label: `Reseña de ${e.data.name}`,
    mono: monogram(e.data.name),
  })),
];

const ld = [
  organizationLd(),
  websiteLd(),
  itemListLd({
    items: top3.map((e) => ({ name: e.data.name, url: new URL(`/brokers/${e.slug}/`, SITE.url).href })),
  }),
];
---
<Layout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  canonicalPath="/"
  headerVariant="onDark"
  surface="bare"
  jsonLd={ld}
>
  <section class="hero">
    <div class="container">
      <h1>Encuentra tu bróker para España y Latinoamérica</h1>
      <p class="hero__lead">Compara reseñas, rankings y costes de los principales brokers de forex y CFDs, en español.</p>

      <ul id="rankings" class="hero__cards" aria-label="Rankings y reseñas destacadas">
        {heroCards.map((card) => (
          <li>
            <a href={card.href}>
              <span class="hcard__icon" aria-hidden="true">
                {card.mono ? (
                  card.mono
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="6" />
                    <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
                  </svg>
                )}
              </span>
              <span class="hcard__label">{card.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="comparativa" class="shell-section container">
    <h2>Comparativa de brokers</h2>
    <div class="island">
      <ComparisonTable
        entries={byRank}
        showFilters
        caption="Comparativa de los brokers analizados por Barrelshoe Trading"
      />
      {!hasBrokers && (
        <p class="empty-state">
          Próximamente: estamos terminando de analizar los brokers y publicaremos la comparativa muy pronto.
        </p>
      )}
    </div>
  </section>

  <section class="shell-section container">
    <h2>Los 3 mejores brokers ahora mismo</h2>
    <div class="island">
      <CategoryRanking entries={top3} />
      {!hasBrokers && (
        <p class="empty-state">
          Próximamente: el ranking con los mejores brokers estará disponible en breve.
        </p>
      )}
    </div>
  </section>

  <section class="shell-section container container-narrow">
    <div class="island methodology-teaser">
      <h2>Nuestra metodología</h2>
      <p>{SITE.methodologyBlurb}</p>
      <p><a href="/metodologia/">Ver la metodología completa →</a></p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: var(--color-shell);
    color: var(--color-on-shell-dim);
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + var(--space-8));
    padding-bottom: var(--space-8);
    text-align: center;
  }
  .hero h1 {
    color: var(--color-on-shell);
    font-weight: 800;
    font-size: clamp(1.7rem, 2.4vw + 1rem, 2.4rem);
    max-width: 22ch;
    margin-inline: auto;
  }
  .hero__lead {
    color: var(--color-on-shell-dim);
    font-size: var(--font-size-base);
    max-width: 52ch;
    margin: var(--space-3) auto 0;
  }

  .hero__cards {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(2, 1fr);
  }
  .hero__cards a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    height: 100%;
    text-align: center;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    transition: transform 0.14s ease, box-shadow 0.14s ease;
  }
  .hero__cards a:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
    text-decoration: none;
  }
  .hcard__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-primary-tint);
    color: var(--color-primary);
    font-weight: 800;
    font-size: var(--font-size-xs);
    flex: 0 0 auto;
  }
  .hcard__icon svg { width: 1.05rem; height: 1.05rem; }
  .hcard__label {
    font-size: var(--font-size-xs);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
  }

  .shell-section { padding-block: var(--space-12); }
  .shell-section > h2 { margin-bottom: var(--space-6); }
  .empty-state { margin-top: var(--space-4); color: var(--color-text-muted); font-size: var(--font-size-sm); }

  .methodology-teaser p { color: var(--color-text); }
  .methodology-teaser p + p { margin-top: var(--space-3); }

  @media (min-width: 560px) {
    .hero__cards { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 860px) {
    .hero__cards { gap: var(--space-4); }
    .hero__cards a { padding: var(--space-4) var(--space-3); }
  }
</style>
