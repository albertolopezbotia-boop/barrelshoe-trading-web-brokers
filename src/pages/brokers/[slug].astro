---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionTabs from '../../components/SectionTabs.astro';
import ScoreRing from '../../components/ScoreRing.astro';
import DimensionBars from '../../components/DimensionBars.astro';
import RegulationSummary from '../../components/RegulationSummary.astro';
import RegulationTable from '../../components/RegulationTable.astro';
import CompanyProfile from '../../components/CompanyProfile.astro';
import AccountTypes from '../../components/AccountTypes.astro';
import SpecChips from '../../components/SpecChips.astro';
import ProsCons from '../../components/ProsCons.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import Faq from '../../components/Faq.astro';
import CategoryRanking from '../../components/CategoryRanking.astro';
import Disclosure from '../../components/Disclosure.astro';
import { money, pips, yesNo } from '../../lib/format';
import { SITE } from '../../data/site';
import { relatedBrokers, type BrokerEntry } from '../../lib/brokers';
import { reviewLd, faqPageLd, breadcrumbListLd, organizationLd } from '../../lib/jsonld';
import { aggregateRating } from '../../lib/rating';

export async function getStaticPaths() {
  const brokers = await getCollection('brokers');
  const entries: BrokerEntry[] = brokers.map((e) => ({ slug: e.slug, data: e.data }));
  return brokers.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, entries },
  }));
}

interface Props {
  entry: CollectionEntry<'brokers'>;
  entries: BrokerEntry[];
}

const { entry, entries } = Astro.props;
const d = entry.data;

if (import.meta.env.DEV && Math.abs(aggregateRating(d.ratingBreakdown) - d.rating) > 0.15) {
  throw new Error(
    `${entry.slug}: rating ${d.rating} no coincide con el desglose (${aggregateRating(d.ratingBreakdown)})`,
  );
}

const dateFmt = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' });
const monogram = d.name
  .replace(/[^\p{L} ]/gu, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]!.toUpperCase())
  .join('');

const costSpecs: Array<{ label: string; value: string }> = [
  { label: 'Depósito mínimo', value: money(d.minDeposit) },
  { label: 'Spread EUR/USD desde', value: pips(d.spreadEurUsdFrom) },
  {
    label: 'Comisión por lote',
    value: d.commissionPerLot
      ? `${money(d.commissionPerLot)} (ida y vuelta)`
      : 'Sin comisión en las cuentas estándar',
  },
  { label: 'Apalancamiento máx.', value: d.leverageMax },
  { label: 'Cuenta sin swap', value: yesNo(d.swapFree) },
  { label: 'Tiempo de retirada', value: d.withdrawalTimeTypical },
  { label: 'Comisiones de retirada', value: d.withdrawalFees },
  { label: 'Métodos de pago', value: d.paymentMethods.join(' · ') },
];

const tabs = [
  { id: 'resumen', label: 'Resumen' },
  { id: 'regulacion', label: 'Regulación' },
  { id: 'empresa', label: 'Empresa' },
  { id: 'cuentas', label: 'Costes y cuentas' },
  { id: 'plataformas', label: 'Plataformas' },
  { id: 'analisis', label: 'Análisis' },
];

const { Content } = await entry.render();
const related = relatedBrokers(entries, entry.slug, 3);

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Brokers', path: '/#comparativa' },
  { name: d.name, path: `/brokers/${entry.slug}/` },
];

const ld = [
  organizationLd(),
  reviewLd({ broker: d, slug: entry.slug }),
  faqPageLd(d.faq),
  breadcrumbListLd(crumbs.map((c) => ({ name: c.name, path: c.path }))),
];
---

<Layout
  title={`${d.name}: análisis y opiniones 2026 | ${SITE.name}`}
  description={d.bottomLine}
  canonicalPath={`/brokers/${entry.slug}/`}
  ogType="article"
  jsonLd={ld}
>
  <div class="container broker-top">
    <Breadcrumbs crumbs={crumbs} />
  </div>

  <SectionTabs items={tabs} />

  <div class="container broker-review">
    <section id="resumen" class="hero">
      <div class="hero__id">
        <span class="hero__logo" aria-hidden="true">{monogram}</span>
        <div>
          <h1>{d.name}: análisis y opiniones</h1>
          <p class="hero__meta">
            <span>{d.headquarters}</span>
            <span>Fundado en {d.founded}</span>
            <span>{d.ownership.split(/[(,]/)[0]!.trim()}</span>
          </p>
        </div>
      </div>

      <div class="hero__score">
        <ScoreRing value={d.rating} />
        <DimensionBars breakdown={d.ratingBreakdown} />
      </div>

      <RegulationSummary regulators={d.regulators} />

      <p class="hero__verdict">{d.bottomLine}</p>

      <div class="hero__cta">
        <AffiliateButton href={d.affiliateUrl} broker={d.name} />
        <a class="ghost-btn" href={d.websiteUrl} target="_blank" rel="nofollow noopener">
          Ir a la web oficial
        </a>
        <p class="hero__note">
          Enlace de afiliado — no cambia nuestra valoración · datos revisados el {dateFmt.format(d.lastUpdated)}
        </p>
      </div>
    </section>

    <section id="regulacion" class="review-block">
      <div class="block-h">
        <h2>Regulación</h2>
        <span class="block-h__count">{d.regulators.length} licencias</span>
      </div>
      <RegulationTable regulators={d.regulators} />
    </section>

    <section id="empresa" class="review-block">
      <h2>Empresa</h2>
      <CompanyProfile broker={d} />
    </section>

    <section id="cuentas" class="review-block">
      <h2>Costes y cuentas</h2>
      <dl class="spec-list">
        {costSpecs.map((s) => (
          <div class="spec-list__row">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
      <h3 class="sub-h">Tipos de cuenta</h3>
      <AccountTypes accountTypes={d.accountTypes} />
      <p class="spec-note">
        Los spreads y comisiones varían según el tipo de cuenta y las condiciones de mercado;
        confirma las cifras actuales en la web oficial de {d.name} antes de operar.
      </p>
    </section>

    <section id="plataformas" class="review-block">
      <h2>Plataformas e instrumentos</h2>
      <SpecChips broker={d} />
    </section>

    <section id="analisis" class="review-block">
      <h2>Análisis</h2>
      <div class="review-body">
        <Content />
      </div>
      <ProsCons pros={d.pros} cons={d.cons} />
    </section>

    <Faq items={d.faq} />

    <section class="related">
      <h2>Brokers relacionados</h2>
      <CategoryRanking entries={related} />
    </section>

    <Disclosure />
  </div>
</Layout>

<style>
  .broker-top { padding-top: var(--space-6); }
  .broker-review {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-bottom: var(--space-16);
    max-width: 60rem;
  }

  .hero {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--color-primary-tint), var(--color-surface-raised) 62%);
    scroll-margin-top: 6rem;
  }
  .hero__id { display: flex; align-items: center; gap: var(--space-4); }
  .hero__logo {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 12px;
    background: var(--color-ink);
    color: var(--color-text-inverse);
    font-weight: 800;
    font-size: var(--font-size-lg);
  }
  .hero__id h1 { margin: 0; font-size: var(--font-size-2xl); }
  .hero__meta {
    margin: var(--space-1) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
  .hero__score { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6); }
  .hero__score :global(.dim-bars) { flex: 1 1 16rem; }
  .hero__verdict { margin: 0; max-width: 62ch; color: var(--color-text); font-size: var(--font-size-lg); }

  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .ghost-btn {
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    font-size: var(--font-size-sm);
    color: var(--color-primary);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    padding: var(--space-3) var(--space-4);
  }
  .ghost-btn:hover { text-decoration: none; background: var(--color-surface); }
  .hero__note { flex-basis: 100%; margin: 0; font-size: var(--font-size-xs); color: var(--color-text-muted); }

  .review-block { display: flex; flex-direction: column; gap: var(--space-4); scroll-margin-top: 6rem; }
  .review-block h2 { margin: 0; }
  .sub-h { margin: var(--space-4) 0 0; font-size: var(--font-size-lg); }
  .block-h { display: flex; align-items: baseline; gap: var(--space-3); }
  .block-h__count { font-size: var(--font-size-sm); color: var(--color-text-muted); font-weight: 600; }

  .spec-list {
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    padding: var(--space-2) var(--space-6);
  }
  .spec-list__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
  }
  .spec-list__row:last-child { border-bottom: 0; }
  .spec-list dt { color: var(--color-text-muted); flex: 0 0 auto; }
  .spec-list dd { margin: 0; font-weight: 600; color: var(--color-ink); text-align: right; }
  .spec-note { margin: 0; font-size: var(--font-size-xs); color: var(--color-text-muted); }

  .review-body :global(h2) {
    margin-top: var(--space-8);
    font-size: var(--font-size-xl);
  }
  .review-body :global(h2:first-child) { margin-top: 0; }
  .review-body :global(p) { margin-top: var(--space-3); }
  .review-body { margin-bottom: var(--space-4); }

  .related h2 { margin: 0 0 var(--space-4); }

  @media (max-width: 560px) {
    .hero { padding: var(--space-6); }
    .spec-list__row { flex-direction: column; gap: var(--space-1); }
    .spec-list dd { text-align: left; }
  }
</style>
