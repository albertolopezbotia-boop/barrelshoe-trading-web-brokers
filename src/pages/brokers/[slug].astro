---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RatingStars from '../../components/RatingStars.astro';
import ProsCons from '../../components/ProsCons.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import FactSheet from '../../components/FactSheet.astro';
import RegulationTable from '../../components/RegulationTable.astro';
import CompanyProfile from '../../components/CompanyProfile.astro';
import Faq from '../../components/Faq.astro';
import CategoryRanking from '../../components/CategoryRanking.astro';
import Disclosure from '../../components/Disclosure.astro';
import { SITE } from '../../data/site';
import { relatedBrokers, type BrokerEntry } from '../../lib/brokers';
import { reviewLd, faqPageLd, breadcrumbListLd, organizationLd } from '../../lib/jsonld';
import { aggregateRating } from '../../lib/rating';

export async function getStaticPaths() {
  const brokers = await getCollection('brokers');
  const entries: BrokerEntry[] = brokers.map((e) => ({ slug: e.slug, data: e.data }));
  return brokers.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, entries },
  }));
}

interface Props {
  entry: CollectionEntry<'brokers'>;
  entries: BrokerEntry[];
}

const { entry, entries } = Astro.props;
const d = entry.data;

const dateFmt = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' });
const scoreFmt = new Intl.NumberFormat('es-ES', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
const ratingRows: Array<{ label: string; value: number }> = [
  { label: 'Costes', value: d.ratingBreakdown.fees },
  { label: 'Plataformas', value: d.ratingBreakdown.platforms },
  { label: 'Depósitos y retiros', value: d.ratingBreakdown.deposits },
  { label: 'Atención al cliente', value: d.ratingBreakdown.support },
  { label: 'Regulación', value: d.ratingBreakdown.regulation },
];

if (import.meta.env.DEV && Math.abs(aggregateRating(d.ratingBreakdown) - d.rating) > 0.15) {
  throw new Error(
    `${entry.slug}: rating ${d.rating} no coincide con el desglose (${aggregateRating(d.ratingBreakdown)})`,
  );
}

const { Content } = await entry.render();
const related = relatedBrokers(entries, entry.slug, 3);

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Brokers', path: '/#comparativa' },
  { name: d.name, path: `/brokers/${entry.slug}/` },
];

const ld = [
  organizationLd(),
  reviewLd({ broker: d, slug: entry.slug }),
  faqPageLd(d.faq),
  breadcrumbListLd(crumbs.map((c) => ({ name: c.name, path: c.path }))),
];
---

<Layout
  title={`${d.name}: análisis y opiniones 2026 | ${SITE.name}`}
  description={d.bottomLine}
  canonicalPath={`/brokers/${entry.slug}/`}
  ogType="article"
  jsonLd={ld}
>
  <div class="container broker-review">
    <Breadcrumbs crumbs={crumbs} />

    <header class="broker-head">
      <div class="broker-head__main">
        <img src={d.logo} alt={`Logo de ${d.name}`} width="120" height="48" class="broker-head__logo" />
        <h1>{d.name}: análisis, spreads y opiniones</h1>
        <div class="broker-head__rating">
          <RatingStars value={d.rating} showNumber />
        </div>
        <p class="bottom-line">{d.bottomLine}</p>
        <p class="broker-updated">Datos revisados el {dateFmt.format(d.lastUpdated)}</p>
      </div>
      <div class="broker-head__cta">
        <AffiliateButton href={d.affiliateUrl} broker={d.name} />
        <Disclosure variant="inline" />
      </div>
    </header>

    <section class="review-block">
      <h2>Datos clave</h2>
      <FactSheet broker={d} />
    </section>

    <ProsCons pros={d.pros} cons={d.cons} />

    <section class="review-block rating-breakdown">
      <h2>Desglose de la valoración</h2>
      <ul class="score-grid">
        {ratingRows.map((row) => (
          <li>
            <span class="score-grid__label">{row.label}</span>
            <span class="score-grid__bar" aria-hidden="true">
              <span class="score-grid__fill" style={`width:${(row.value / 5) * 100}%`}></span>
            </span>
            <span class="score-grid__value">{scoreFmt.format(row.value)}<small> / 5</small></span>
          </li>
        ))}
      </ul>
    </section>

    <section class="review-body">
      <Content />
    </section>

    <section class="review-block">
      <h2>Perfil de empresa</h2>
      <CompanyProfile broker={d} />
    </section>

    <section class="review-block">
      <h2>Regulación</h2>
      <RegulationTable regulators={d.regulators} />
    </section>

    <Faq items={d.faq} />

    <section class="related">
      <h2>Brokers relacionados</h2>
      <CategoryRanking entries={related} />
    </section>
  </div>
</Layout>

<style>
  .broker-review {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-block: var(--space-8);
  }
  .broker-head {
    display: grid;
    gap: var(--space-6);
    align-items: start;
    padding: var(--space-8);
    background: linear-gradient(180deg, var(--color-primary-tint), var(--color-surface-raised) 60%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .broker-head__main { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .broker-head__logo { height: 40px; width: auto; object-fit: contain; object-position: left center; }
  .broker-head h1 { margin: 0; }
  .broker-head__rating { font-size: var(--font-size-lg); }
  .broker-head .bottom-line {
    margin: 0;
    max-width: 60ch;
    color: var(--color-text);
    font-size: var(--font-size-lg);
  }
  .broker-head .broker-updated {
    margin: 0;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
  .broker-head__cta { display: flex; flex-direction: column; gap: var(--space-2); }
  @media (min-width: 780px) {
    .broker-head { grid-template-columns: 1fr auto; }
    .broker-head__cta { align-items: flex-end; text-align: right; }
  }

  .review-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .review-block h2 { margin: 0; }

  .score-grid {
    list-style: none;
    margin: 0;
    padding: var(--space-4) var(--space-6);
    display: grid;
    gap: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }
  .score-grid li {
    display: grid;
    grid-template-columns: 12rem 1fr auto;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--font-size-sm);
  }
  .score-grid__label { color: var(--color-text-muted); }
  .score-grid__bar {
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    overflow: hidden;
  }
  .score-grid__fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-primary), #4f8bff);
  }
  .score-grid__value { font-weight: 800; color: var(--color-ink); white-space: nowrap; }
  .score-grid__value small { color: var(--color-text-muted); font-weight: 600; }
  @media (max-width: 560px) {
    .score-grid li { grid-template-columns: 1fr auto; }
    .score-grid__bar { grid-column: 1 / -1; order: 3; }
  }

  .review-body :global(h2) { margin-top: var(--space-8); }
  .review-body :global(p) { margin-top: var(--space-3); }
  .related h2 { margin: 0 0 var(--space-4); }
</style>
