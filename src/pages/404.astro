---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';
---

<Layout
  title={`Página no encontrada | ${SITE.name}`}
  description="La página que buscas no existe o se ha movido."
  canonicalPath="/404"
  noindex={true}
>
  <div class="container notfound">
    <p class="code">Error 404</p>
    <h1>Página no encontrada</h1>
    <p>
      La página que buscas no existe o se ha movido. Puede que el enlace esté desactualizado o que
      haya un error en la dirección.
    </p>
    <ul>
      <li><a href="/">Volver a la portada</a></li>
      <li><a href="/#comparativa">Ir a la comparativa de brokers</a></li>
      <li><a href="/metodologia/">Ver nuestra metodología</a></li>
    </ul>
  </div>
</Layout>

<style>
  .notfound {
    padding-block: var(--space-16);
    max-width: var(--container-narrow);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .notfound h1 { margin: 0; }
  .notfound p { margin: 0; }
  .notfound .code {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .notfound ul {
    margin: 0;
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
