---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: object[];
  headerVariant?: 'default' | 'onDark';
}

const { title, description, canonicalPath, ogImage = "/og/default.png", ogType = "website", noindex = false, jsonLd = [], headerVariant = 'default' } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site).href;
const ogImageAbs = new URL(ogImage, Astro.site).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImageAbs}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <link rel="icon" href="/brand/barrelshoe-icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/barrelshoe-icon.png" />
  </head>
  <body class:list={{ 'hero-dark': headerVariant === 'onDark' }}>
    <a class="visually-hidden" href="#contenido">Saltar al contenido</a>
    <Header onDark={headerVariant === 'onDark'} />
    <main id="contenido"><slot /></main>
    <Footer />
  </body>
</html>
